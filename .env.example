# Optional alternative to private data/vestel-client.json:
# VESTEL_CLIENT_ID=YOUR_AUTHORIZED_SERVICE_CLIENT_ID
# VESTEL_CLIENT_SECRET=YOUR_AUTHORIZED_SERVICE_CLIENT_SECRET
